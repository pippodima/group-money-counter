{
  "name": "group-money-counter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An offline-only shared expense ledger that syncs between devices by QR code.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:offline",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:offline": "node scripts/check-offline.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
