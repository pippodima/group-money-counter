{
  "name": "group-money-counter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An offline-only shared expense ledger that syncs between devices by QR code.",
  "license": "MIT",
  "homepage": "https://pippodima.github.io/group-money-counter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pippodima/group-money-counter.git"
  },
  "bugs": {
    "url": "https://github.com/pippodima/group-money-counter/issues"
  },
  "keywords": [
    "expense-splitting",
    "offline-first",
    "local-first",
    "pwa",
    "qr-code",
    "event-sourcing",
    "crdt",
    "privacy"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:offline",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:offline": "node scripts/check-offline.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
